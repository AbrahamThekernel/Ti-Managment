                           <VBox.margin>
                              <Insets left="245.0" />
                           </VBox.margin></Label>
                        <TextField fx:id="txtCorreo" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" />
                     </children>
                     <HBox.margin>
                        <Insets top="45.0" />
                     </HBox.margin>
                  </VBox>
               </children>
            </HBox>
         </top>
         <center>
            <HBox prefHeight="236.0" prefWidth="600.0" BorderPane.alignment="CENTER">
