<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
  Pantalla de inicio de sesión.
  No usa archivo CSS: todos los controles son JavaFX normales y el aspecto
  monocromático está definido directamente en FXML.
-->
<BorderPane prefHeight="720.0" prefWidth="1280.0"
            style="-fx-background-color: #f4f4f4; -fx-font-family: 'Segoe UI';"
            xmlns="http://javafx.com/javafx/13"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="utng.gtid.jjcm.PrimaryController">
   <center>
      <!-- StackPane centra el formulario dentro de cualquier tamaño de ventana. -->
      <StackPane>
         <children>
            <!-- VBox contiene todos los elementos del formulario en orden vertical. -->
            <VBox alignment="CENTER" spacing="12.0" maxWidth="390.0"
                  style="-fx-background-color: white; -fx-border-color: #cccccc; -fx-border-radius: 6; -fx-background-radius: 6;">
               <padding><Insets top="30.0" right="34.0" bottom="30.0" left="34.0" /></padding>
               <children>
                  <!-- Identidad institucional corregida: UTNG. -->
                  <Label text="UTNG" style="-fx-font-size: 25px; -fx-font-weight: bold;" />
                  <Label text="Gestión Institucional" style="-fx-font-size: 13px; -fx-text-fill: #555555;" />
                  <Region prefHeight="12.0" />

                  <!-- Correo del usuario activo que desea iniciar sesión. -->
                  <Label text="Correo institucional" maxWidth="Infinity"
                         style="-fx-font-size: 10px; -fx-font-weight: bold;" />
                  <TextField fx:id="txtCorreoLogin"
                             promptText="usuario@utng.edu.mx"
                             prefHeight="38.0" maxWidth="Infinity" />

                  <!-- PasswordField oculta los caracteres de la contraseña. -->
                  <Label text="Contraseña" maxWidth="Infinity"
                         style="-fx-font-size: 10px; -fx-font-weight: bold;" />
                  <PasswordField fx:id="txtContrasenaLogin"
                                 promptText="Contraseña"
                                 prefHeight="38.0" maxWidth="Infinity" />

                  <!-- Etiqueta reservada para errores de validación. -->
                  <Label fx:id="lblErrorLogin" text="" wrapText="true" maxWidth="Infinity"
                         style="-fx-font-size: 10px; -fx-text-fill: #555555;" />

                  <!-- Botón normal enlazado al método iniciarSesion. -->
                  <Button fx:id="btnIniciarSesion" text="Iniciar sesión"
                          onAction="#iniciarSesion" prefHeight="40.0" maxWidth="Infinity"
                          style="-fx-background-color: #e5e5e5; -fx-border-color: #c5c5c5; -fx-font-weight: bold;" />

                  <!-- Explicación del primer acceso cuando aún no existe hash. -->
                  <Label text="En el primer acceso, deja la contraseña vacía y configúrala después en Mi perfil."
                         wrapText="true" textAlignment="CENTER" maxWidth="Infinity"
                         style="-fx-font-size: 9px; -fx-text-fill: #777777;" />
               </children>
            </VBox>
         </children>
      </StackPane>
   </center>
</BorderPane>
