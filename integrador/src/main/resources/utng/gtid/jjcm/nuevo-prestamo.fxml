<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="768.0" prefWidth="1366.0"
            style="-fx-background-color: #f7f7f7; -fx-font-family: 'Segoe UI'; -fx-font-size: 12px;"
            xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="utng.gtid.jjcm.NuevoPrestamoController">
   <left>
      <VBox prefWidth="215.0" minWidth="215.0" maxWidth="215.0" spacing="5.0" style="-fx-background-color: white; -fx-border-color: transparent #d7d7d7 transparent transparent; -fx-border-width: 0 1 0 0;">
         <padding><Insets top="14.0" right="12.0" bottom="14.0" left="12.0" /></padding>
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0"><children><StackPane prefHeight="38.0" prefWidth="38.0" minHeight="38.0" minWidth="38.0" style="-fx-background-color: #eeeeee; -fx-border-color: #bcbcbc;"><children><Label text="◇" style="-fx-font-size: 23px; -fx-text-fill: #9a9a9a;" /></children></StackPane><VBox spacing="1.0"><children><Label text="UTNG" style="-fx-font-size: 16px; -fx-font-weight: bold;" /><Label text="Gestión Institucional" style="-fx-font-size: 9px; -fx-text-fill: #666666;" /></children></VBox></children></HBox>
            <TextField fx:id="txtBuscarModulo" promptText="⌕  Buscar módulo..." prefHeight="31.0" style="-fx-background-color: white; -fx-border-color: #d4d4d4; -fx-border-radius: 3; -fx-background-radius: 3; -fx-prompt-text-fill: #999999;"><VBox.margin><Insets top="7.0" /></VBox.margin></TextField>
            <Label text="MENÚ PRINCIPAL" style="-fx-font-size: 9px; -fx-text-fill: #888888;"><VBox.margin><Insets top="5.0" left="4.0" /></VBox.margin></Label>
            <Button fx:id="btnEstadisticas" userData="estadisticas" onAction="#cambiarVista" text="▥   Estadísticas" prefHeight="31.0" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-alignment: CENTER_LEFT;" />
            <Button fx:id="btnInventario" userData="inventario" onAction="#cambiarVista" text="◇   Inventario" prefHeight="31.0" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-alignment: CENTER_LEFT;" />
            <Button fx:id="btnPrestamos" userData="prestamos" onAction="#cambiarVista" text="▣   Préstamos" prefHeight="31.0" maxWidth="Infinity" style="-fx-background-color: #e9e9e9; -fx-border-color: #d3d3d3; -fx-background-radius: 3; -fx-border-radius: 3; -fx-alignment: CENTER_LEFT; -fx-font-weight: bold;" />
            <Button fx:id="btnOrdenesServicio" userData="ordenes-servicio" onAction="#cambiarVista" text="▧   Órdenes de servicio" prefHeight="31.0" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-alignment: CENTER_LEFT;" />
            <Button fx:id="btnMantenimientos" userData="mantenimientos" onAction="#cambiarVista" text="⌕   Mantenimientos" prefHeight="31.0" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-alignment: CENTER_LEFT;" />
            <Button fx:id="btnEquipos" userData="equipos" onAction="#cambiarVista" text="▱   Equipos" prefHeight="31.0" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-alignment: CENTER_LEFT;" />
            <Button fx:id="btnUsuarios" userData="usuarios" onAction="#cambiarVista" text="♙   Usuarios" prefHeight="31.0" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-alignment: CENTER_LEFT;" />
            <Button fx:id="btnReportes" userData="reportes" onAction="#cambiarVista" text="▤   Reportes" prefHeight="31.0" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-alignment: CENTER_LEFT;" />
            <Button fx:id="btnRespaldos" userData="respaldos" onAction="#cambiarVista" text="▦   Respaldos" prefHeight="31.0" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-alignment: CENTER_LEFT;" />
            <Separator><VBox.margin><Insets top="7.0" bottom="7.0" /></VBox.margin></Separator>
            <Button fx:id="btnPerfil" userData="mi-perfil" onAction="#cambiarVista" text="◎   Mi perfil" prefHeight="31.0" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-alignment: CENTER_LEFT;" />
            <Button fx:id="btnCerrarSesion" onAction="#cerrarSesion" text="↪   Cerrar sesión" prefHeight="31.0" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-alignment: CENTER_LEFT;" />
            <Region VBox.vgrow="ALWAYS" />
            <Separator><VBox.margin><Insets bottom="9.0" /></VBox.margin></Separator>
            <HBox alignment="CENTER_LEFT" spacing="10.0"><children><StackPane prefHeight="34.0" prefWidth="34.0" minHeight="34.0" minWidth="34.0" style="-fx-background-color: #d8d8d8; -fx-background-radius: 20;" /><VBox spacing="1.0"><children><Label fx:id="lblNombreSesion" text="Usuario" style="-fx-font-size: 10px; -fx-font-weight: bold;" /><Label fx:id="lblRolSesion" text="Rol" style="-fx-font-size: 9px; -fx-text-fill: #666666;" /></children></VBox><Region HBox.hgrow="ALWAYS" /><Label text="●" style="-fx-text-fill: #999999; -fx-font-size: 8px;" /></children></HBox>
         </children>
      </VBox>
   </left>
   <center>
      <BorderPane>
         <top>
            <HBox alignment="CENTER_LEFT" prefHeight="74.0" spacing="12.0" style="-fx-background-color: white; -fx-border-color: transparent transparent #dddddd transparent; -fx-border-width: 0 0 1 0;">
               <padding><Insets top="9.0" right="18.0" bottom="9.0" left="18.0" /></padding>
               <children>
                  <Button fx:id="btnMenu" text="☰" style="-fx-background-color: transparent; -fx-font-size: 19px; -fx-text-fill: #666666;" />
                  <VBox spacing="3.0"><children><Label text="Inicio   ›   Préstamos   ›   Nuevo préstamo" style="-fx-font-size: 9px; -fx-text-fill: #888888;" /><Label text="Registrar nuevo préstamo" style="-fx-font-size: 17px; -fx-font-weight: bold;" /></children></VBox>
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="btnVolver" text="‹  Volver a préstamos" onAction="#cancelar" style="-fx-background-color: white; -fx-border-color: #d0d0d0; -fx-border-radius: 4; -fx-background-radius: 4;" />
                  <StackPane prefHeight="31.0" prefWidth="31.0" minHeight="31.0" minWidth="31.0" style="-fx-background-color: #d9d9d9; -fx-background-radius: 20;" />
                  <Button fx:id="btnNotificaciones" text="♧" style="-fx-background-color: transparent; -fx-font-size: 18px; -fx-text-fill: #666666;" />
               </children>
            </HBox>
         </top>
         <center>
            <HBox spacing="14.0" style="-fx-background-color: #f7f7f7;">
               <padding><Insets top="16.0" right="18.0" bottom="18.0" left="18.0" /></padding>
               <children>
                  <VBox spacing="12.0" HBox.hgrow="ALWAYS">
                     <children>
                        <VBox spacing="11.0" style="-fx-background-color: white; -fx-border-color: #d3d3d3; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 16;">
                           <children>
                              <Label text="1. Datos del solicitante" style="-fx-font-size: 13px; -fx-font-weight: bold;" />
                              <Label text="Selecciona a la persona responsable del equipo." style="-fx-font-size: 9px; -fx-text-fill: #666666;" />
                              <Separator />
                              <HBox spacing="12.0">
                                 <children>
                                    <VBox spacing="5.0" maxWidth="Infinity" HBox.hgrow="ALWAYS"><children><Label text="Profesor o solicitante *" style="-fx-font-size: 9px; -fx-font-weight: bold;" /><ComboBox fx:id="cmbProfesor" promptText="Selecciona un profesor" prefHeight="37.0" maxWidth="Infinity" style="-fx-background-color: white; -fx-border-color: #d2d2d2; -fx-border-radius: 3; -fx-background-radius: 3;" /></children></VBox>
                                    <VBox spacing="5.0" maxWidth="Infinity" HBox.hgrow="ALWAYS"><children><Label text="Motivo del préstamo" style="-fx-font-size: 9px; -fx-font-weight: bold;" /><TextField fx:id="txtMotivo" promptText="Clase, presentación, evento..." prefHeight="37.0" style="-fx-background-color: white; -fx-border-color: #d2d2d2; -fx-border-radius: 3; -fx-background-radius: 3;" /></children></VBox>
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                        <VBox spacing="11.0" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-border-color: #d3d3d3; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 16;">
                           <children>
                              <Label text="2. Equipo y periodo del préstamo" style="-fx-font-size: 13px; -fx-font-weight: bold;" />
                              <Label text="Indica el artículo, la cantidad y las fechas correspondientes." style="-fx-font-size: 9px; -fx-text-fill: #666666;" />
                              <Separator />
                              <HBox spacing="12.0">
                                 <children>
                                    <VBox spacing="5.0" maxWidth="Infinity" HBox.hgrow="ALWAYS"><children><Label text="Equipo o producto *" style="-fx-font-size: 9px; -fx-font-weight: bold;" /><ComboBox fx:id="cmbEquipo" promptText="Selecciona un equipo" prefHeight="37.0" maxWidth="Infinity" style="-fx-background-color: white; -fx-border-color: #d2d2d2; -fx-border-radius: 3; -fx-background-radius: 3;" /></children></VBox>
                                    <VBox spacing="5.0" prefWidth="150.0"><children><Label text="Cantidad *" style="-fx-font-size: 9px; -fx-font-weight: bold;" /><TextField fx:id="txtCantidad" promptText="1" prefHeight="37.0" style="-fx-background-color: white; -fx-border-color: #d2d2d2; -fx-border-radius: 3; -fx-background-radius: 3;" /></children></VBox>
                                 </children>
                              </HBox>
                              <HBox spacing="12.0">
                                 <children>
                                    <VBox spacing="5.0" maxWidth="Infinity" HBox.hgrow="ALWAYS"><children><Label text="Fecha del préstamo *" style="-fx-font-size: 9px; -fx-font-weight: bold;" /><DatePicker fx:id="dpFechaPrestamo" prefHeight="37.0" maxWidth="Infinity" style="-fx-background-color: white; -fx-border-color: #d2d2d2; -fx-border-radius: 3; -fx-background-radius: 3;" /></children></VBox>
                                    <VBox spacing="5.0" maxWidth="Infinity" HBox.hgrow="ALWAYS"><children><Label text="Fecha de devolución *" style="-fx-font-size: 9px; -fx-font-weight: bold;" /><DatePicker fx:id="dpFechaDevolucion" prefHeight="37.0" maxWidth="Infinity" style="-fx-background-color: white; -fx-border-color: #d2d2d2; -fx-border-radius: 3; -fx-background-radius: 3;" /></children></VBox>
                                 </children>
                              </HBox>
                              <VBox spacing="5.0" VBox.vgrow="ALWAYS"><children><Label text="Observaciones" style="-fx-font-size: 9px; -fx-font-weight: bold;" /><TextArea fx:id="txtObservaciones" promptText="Agrega indicaciones sobre la entrega o el uso del equipo..." prefRowCount="3" wrapText="true" VBox.vgrow="ALWAYS" style="-fx-background-color: white; -fx-border-color: #d2d2d2; -fx-border-radius: 3; -fx-background-radius: 3;" /></children></VBox>
                              <CheckBox fx:id="chkResponsiva" text="Confirmo que el solicitante acepta la responsabilidad sobre el equipo." style="-fx-font-size: 10px;" />
                           </children>
                        </VBox>
                     </children>
                  </VBox>
                  <VBox prefWidth="310.0" minWidth="310.0" spacing="12.0">
                     <children>
                        <VBox spacing="11.0" style="-fx-background-color: white; -fx-border-color: #d3d3d3; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 16;">
                           <children>
                              <Label text="Resumen del préstamo" style="-fx-font-size: 13px; -fx-font-weight: bold;" />
                              <Separator />
                              <StackPane prefHeight="115.0" maxWidth="Infinity" style="-fx-background-color: #eeeeee; -fx-border-color: #d0d0d0;"><children><Label text="◇" style="-fx-font-size: 36px; -fx-text-fill: #aaaaaa;" /></children></StackPane>
                              <Label text="SOLICITANTE" style="-fx-font-size: 8px; -fx-text-fill: #777777;" />
                              <Label fx:id="lblProfesorResumen" text="Sin seleccionar" wrapText="true" style="-fx-font-size: 11px; -fx-font-weight: bold;" />
                              <Label text="EQUIPO" style="-fx-font-size: 8px; -fx-text-fill: #777777;" />
                              <Label fx:id="lblEquipoResumen" text="Sin seleccionar" wrapText="true" style="-fx-font-size: 11px; -fx-font-weight: bold;" />
                              <Label fx:id="lblDisponibilidad" text="Selecciona un equipo" wrapText="true" style="-fx-font-size: 9px; -fx-text-fill: #666666;" />
                           </children>
                        </VBox>
                        <VBox spacing="9.0" style="-fx-background-color: white; -fx-border-color: #d3d3d3; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 16;">
                           <children>
                              <Label text="Antes de registrar" style="-fx-font-size: 11px; -fx-font-weight: bold;" />
                              <Label text="• Verifica la disponibilidad.&#10;• Confirma las fechas.&#10;• Revisa la cantidad solicitada.&#10;• Acepta la responsiva." wrapText="true" style="-fx-font-size: 9px; -fx-text-fill: #555555;" />
                              <Separator />
                              <Label fx:id="lblMensaje" text="Completa los campos obligatorios." wrapText="true" style="-fx-font-size: 9px; -fx-text-fill: #666666;" />
                              <Button fx:id="btnRegistrarPrestamo" text="Registrar préstamo" onAction="#registrarPrestamo" maxWidth="Infinity" prefHeight="40.0" style="-fx-background-color: #e3e3e3; -fx-border-color: #c5c5c5; -fx-border-radius: 4; -fx-background-radius: 4; -fx-font-weight: bold;" />
                              <Button fx:id="btnCancelar" text="Cancelar" onAction="#cancelar" maxWidth="Infinity" prefHeight="36.0" style="-fx-background-color: white; -fx-border-color: #cccccc; -fx-border-radius: 4; -fx-background-radius: 4;" />
                           </children>
                        </VBox>
                     </children>
                  </VBox>
               </children>
            </HBox>
         </center>
      </BorderPane>
   </center>
</BorderPane>
